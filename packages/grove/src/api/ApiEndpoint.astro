---
/**
 * ApiEndpoint — METHOD + path chip with optional deprecated / beta badges.
 *
 * The `id` prop sets a stable anchor so endpoints become deep-linkable and
 * drive scroll-spy behavior in ApiNavTree.
 *
 * Example:
 *   <ApiEndpoint
 *     id="engagements.create"
 *     method="POST"
 *     path="/v1/engagements"
 *     description="Create a new engagement."
 *   />
 */
interface Props {
  method: 'GET' | 'POST' | 'PATCH' | 'DELETE' | 'PUT';
  path: string;
  description?: string;
  version?: string;
  /** Stable DOM id. Used for deep-linking and scroll-spy. */
  id?: string;
  /** Render a deprecation banner + badge. */
  deprecated?: boolean;
  /** Deprecation message (shown in banner when deprecated=true). */
  deprecatedMessage?: string;
  /** Migration target (e.g. "Use POST /v2/engagements instead"). */
  deprecatedLink?: { href: string; label: string };
  /** Render a BETA badge. */
  beta?: boolean;
}
const {
  method,
  path,
  description,
  version,
  id,
  deprecated = false,
  deprecatedMessage,
  deprecatedLink,
  beta = false,
} = Astro.props;

// Human-friendly chip label. Servantium APIs standardize on
// GET / POST / PUT / DELETE (no PATCH). PUT is used for partial and
// full updates. Label stays technical for GET/POST/DELETE; PUT renders
// as UPDATE for readability. PATCH kept in the map for any legacy docs.
const METHOD_LABEL: Record<string, string> = {
  GET: 'GET',
  POST: 'POST',
  PUT: 'UPDATE',
  PATCH: 'UPDATE',
  DELETE: 'DELETE',
};
const methodLabel = METHOD_LABEL[method] ?? method;
---

<section
  class:list={['api-endpoint', deprecated && 'api-endpoint--deprecated']}
  id={id}
  data-api-endpoint={id}
  data-method={method}
>
  {deprecated && (
    <div class="api-endpoint__deprecation" role="note">
      <strong>Deprecated.</strong>
      {deprecatedMessage && <span> {deprecatedMessage}</span>}
      {deprecatedLink && (
        <a href={deprecatedLink.href}>{deprecatedLink.label} →</a>
      )}
    </div>
  )}

  <div class="api-endpoint__row">
    <span class={`api-endpoint__method api-endpoint__method--${method.toLowerCase()}`} title={method}>{methodLabel}</span>
    <code class="api-endpoint__path">{path}</code>
    {id && (
      <a class="api-endpoint__anchor" href={`#${id}`} aria-label="Link to this endpoint">#</a>
    )}
    <div class="api-endpoint__badges">
      {beta && <span class="api-endpoint__badge api-endpoint__badge--beta">Beta</span>}
      {deprecated && <span class="api-endpoint__badge api-endpoint__badge--deprecated">Deprecated</span>}
      {version && <span class="api-endpoint__version">v{version}</span>}
    </div>
  </div>
  {description && <p class="api-endpoint__desc">{description}</p>}
</section>

<style>
  .api-endpoint {
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--surface-widget);
    border: 1px solid var(--surface-widget-border);
    border-radius: var(--r-md);
    scroll-margin-top: 5rem; /* accounts for sticky nav */
  }
  .api-endpoint--deprecated {
    border-color: rgba(255, 176, 46, 0.4);
  }
  .api-endpoint__deprecation {
    margin: -0.25rem 0 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-warning-bg, #FFF8EB);
    color: var(--color-warning-text-dark, #B87A00);
    border-radius: var(--r-sm);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .api-endpoint__deprecation a {
    margin-left: 0.35rem;
    color: var(--color-warning-text-dark, #B87A00);
    text-decoration: underline;
    font-weight: 600;
  }
  .api-endpoint__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .api-endpoint__method {
    padding: 0.25rem 0.625rem;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .api-endpoint__method--get    { background: var(--color-green-soft); color: var(--color-green); border-color: var(--color-green-line); }
  .api-endpoint__method--post   { background: var(--color-slate-blue-soft); color: var(--color-slate-blue); border-color: rgba(76,130,167,0.28); }
  .api-endpoint__method--patch  { background: var(--color-amber-soft); color: var(--color-amber); border-color: rgba(255,176,46,0.28); }
  .api-endpoint__method--delete { background: var(--color-coral-soft); color: var(--color-coral); border-color: rgba(255,92,112,0.28); }
  .api-endpoint__method--put    { background: rgba(38,168,153,0.14); color: var(--color-deep-teal); border-color: rgba(38,168,153,0.28); }

  .api-endpoint__path {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9375rem;
    color: var(--surface-widget-ink);
  }
  .api-endpoint__anchor {
    opacity: 0;
    color: var(--surface-widget-ink-muted);
    text-decoration: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    transition: opacity 0.15s ease;
  }
  .api-endpoint:hover .api-endpoint__anchor,
  .api-endpoint:focus-within .api-endpoint__anchor {
    opacity: 1;
  }
  .api-endpoint__badges {
    margin-left: auto;
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
  }
  .api-endpoint__badge {
    padding: 0.125rem 0.5rem;
    border-radius: var(--r-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .api-endpoint__badge--beta {
    background: var(--color-slate-blue-soft);
    color: var(--color-slate-blue);
  }
  .api-endpoint__badge--deprecated {
    background: var(--color-warning-bg, #FFF8EB);
    color: var(--color-warning-text-dark, #B87A00);
  }
  .api-endpoint__version {
    padding: 0.125rem 0.5rem;
    background: var(--color-green-soft);
    color: var(--color-green);
    border-radius: var(--r-pill);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--type-meta);
    font-weight: 600;
  }
  .api-endpoint__desc {
    font-size: 0.875rem;
    color: var(--surface-widget-ink-muted);
    margin: 0.625rem 0 0;
  }
</style>
