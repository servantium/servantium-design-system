---
/**
 * ApiCodeBlock — standalone syntax-highlighted code block with copy button.
 *
 * Use inline for one-off snippets, or compose inside ApiCodePanel for
 * a multi-language tabbed block.
 *
 * Example (inline):
 *   <ApiCodeBlock lang="bash" code="curl -X POST https://api.servantium.com/v1/engagements" />
 *
 * Example (slot):
 *   <ApiCodeBlock lang="json" filename="response.json">{JSON.stringify({ id: "eng_123" }, null, 2)}</ApiCodeBlock>
 */
interface Props {
  /** Language hint (drives syntax highlight class). */
  lang?: string;
  /** Inline code string. If omitted, the default slot is used. */
  code?: string;
  /** Optional filename shown in the header. */
  filename?: string;
  /** Show the copy button. Default: true. */
  copyable?: boolean;
  /** Suppress the header entirely (lang badge + copy button). */
  hideHeader?: boolean;
}
const { lang = 'bash', code, filename, copyable = true, hideHeader = false } = Astro.props;
const id = `code-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="api-code-block" data-code-block={id}>
  {!hideHeader && (
    <div class="api-code-block__header">
      <span class="api-code-block__meta">
        {filename && <span class="api-code-block__filename">{filename}</span>}
        <span class="api-code-block__lang">{lang}</span>
      </span>
      {copyable && (
        <button type="button" class="api-code-block__copy" data-copy-target={id} aria-label="Copy code">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span class="api-code-block__copy-label">Copy</span>
        </button>
      )}
    </div>
  )}
  <pre class={`api-code-block__pre language-${lang}`}><code data-copy-src>{code !== undefined ? code : <slot />}</code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.api-code-block__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.copyTarget;
      if (!targetId) return;
      const container = document.querySelector(`[data-code-block="${targetId}"]`);
      const src = container?.querySelector<HTMLElement>('[data-copy-src]');
      if (!src) return;
      try {
        await navigator.clipboard.writeText(src.innerText);
        const label = btn.querySelector('.api-code-block__copy-label');
        const original = label?.textContent ?? 'Copy';
        if (label) label.textContent = 'Copied';
        btn.classList.add('api-code-block__copy--success');
        setTimeout(() => {
          if (label) label.textContent = original;
          btn.classList.remove('api-code-block__copy--success');
        }, 1400);
      } catch {
        // clipboard rejected — ignore silently
      }
    });
  });
</script>

<style>
  .api-code-block {
    margin: 1rem 0;
    border: 1px solid var(--surface-widget-border);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--color-dark-bg);
  }
  .api-code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    background: var(--color-dark-surface);
    border-bottom: 1px solid var(--color-dark-border);
    font-size: var(--type-meta);
  }
  .api-code-block__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-dark-ink-3);
  }
  .api-code-block__filename {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-dark-ink-2);
    font-weight: 600;
  }
  .api-code-block__lang {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .api-code-block__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    background: transparent;
    border: 1px solid var(--color-dark-border);
    border-radius: var(--r-sm);
    color: var(--color-dark-ink-2);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .api-code-block__copy:hover {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
  }
  .api-code-block__copy--success {
    color: var(--color-fresh-green);
    border-color: var(--color-fresh-green);
  }
  .api-code-block__pre {
    margin: 0;
    padding: 1rem;
    background: transparent;
    color: var(--color-dark-ink-1);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    line-height: 1.55;
    overflow-x: auto;
  }
</style>
