---
/**
 * WhatsNewGrid — colorful icon cards for the "What's new" section.
 * Each card has a gradient background, icon, title, version + date.
 */
export interface WhatsNewItem {
  title: string;
  href: string;
  version?: string;
  date?: string;
  icon?: 'grid' | 'sparkle' | 'search' | 'calendar' | 'doc' | 'bulb' | 'phone' | 'database';
  accent?: 'green' | 'blue' | 'amber' | 'purple' | 'coral' | 'teal' | 'slate';
}

interface Props {
  items: WhatsNewItem[];
  /**
   * "vivid"  = saturated dark gradients (portal aesthetic, high contrast)
   * "soft"   = tinted light card surfaces (marketing-adjacent, approachable)
   * "plain"  = white cards with accent ink + border (help's original style)
   * Default: "soft" — matches the help site's approachable tone.
   */
  variant?: 'vivid' | 'soft' | 'plain';
  class?: string;
}
const { items = [], variant = 'soft', class: className = '' } = Astro.props;

const vividGradients: Record<string, string> = {
  green:  'linear-gradient(135deg, #0E8A52 0%, #045F37 100%)',
  blue:   'linear-gradient(135deg, #3E6E9A 0%, #1E3850 100%)',
  amber:  'linear-gradient(135deg, #D88B2A 0%, #8C521B 100%)',
  purple: 'linear-gradient(135deg, #6B47B5 0%, #3B2570 100%)',
  coral:  'linear-gradient(135deg, #D95266 0%, #8B2D3D 100%)',
  teal:   'linear-gradient(135deg, #1A8A7F 0%, #0E4F49 100%)',
  slate:  'linear-gradient(135deg, #3E4D5C 0%, #1E2932 100%)',
};

// Tinted card surfaces — gentle light backgrounds with deep accent ink
const softSurfaces: Record<string, { bg: string; ink: string; border: string }> = {
  green:  { bg: '#E8FBF1', ink: '#023E25', border: '#C8F5DE' },
  blue:   { bg: '#EEF4F9', ink: '#1E3850', border: '#D4DFEA' },
  amber:  { bg: '#FFF5E4', ink: '#5C3A15', border: '#F5DFB5' },
  purple: { bg: '#F1ECFB', ink: '#3B2570', border: '#DCD0F2' },
  coral:  { bg: '#FFEBEF', ink: '#7A2333', border: '#F5C6CE' },
  teal:   { bg: '#E4F6F3', ink: '#0E4F49', border: '#BDE5DE' },
  slate:  { bg: '#EEF0F4', ink: '#1E2932', border: '#CFD5DE' },
};

// Auto-assign accents if not specified (cycle through palette).
const palette: Array<WhatsNewItem['accent']> = ['green', 'blue', 'teal', 'amber', 'coral', 'purple', 'teal', 'slate'];
const resolved = items.map((item, i) => ({
  ...item,
  accent: item.accent || palette[i % palette.length],
}));
---

<div class:list={['whats-new-grid', `whats-new-grid--${variant}`, className]}>
  {resolved.map((item) => {
    const accent = item.accent || 'green';
    let cardStyle = '';
    if (variant === 'vivid') {
      cardStyle = `background: ${vividGradients[accent]};`;
    } else if (variant === 'soft') {
      const s = softSurfaces[accent];
      cardStyle = `background: ${s.bg}; color: ${s.ink}; border-color: ${s.border};`;
    } else { /* plain */
      cardStyle = '';
    }
    return (
    <a href={item.href} class="whats-new-grid__card" style={cardStyle} data-accent={accent}>
      <div class="whats-new-grid__icon" aria-hidden="true">
        {item.icon === 'grid' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
          </svg>
        )}
        {item.icon === 'sparkle' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l2 5.5L19.5 11l-5.5 2.5L12 19l-2-5.5L4.5 11l5.5-2.5z"/>
          </svg>
        )}
        {item.icon === 'search' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        )}
        {item.icon === 'calendar' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        )}
        {item.icon === 'doc' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
          </svg>
        )}
        {item.icon === 'bulb' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>
          </svg>
        )}
        {item.icon === 'phone' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18"/>
          </svg>
        )}
        {item.icon === 'database' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>
          </svg>
        )}
        {!item.icon && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l2 5.5L19.5 11l-5.5 2.5L12 19l-2-5.5L4.5 11l5.5-2.5z"/>
          </svg>
        )}
      </div>
      <div class="whats-new-grid__text">
        <h3 class="whats-new-grid__title">{item.title}</h3>
        {(item.version || item.date) && (
          <p class="whats-new-grid__meta">
            {item.version && <span>{item.version}</span>}
            {item.version && item.date && <span aria-hidden="true"> · </span>}
            {item.date && <time>{item.date}</time>}
          </p>
        )}
      </div>
      <div class="whats-new-grid__decoration" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none">
          <circle cx="80" cy="20" r="24" fill="rgba(255,255,255,0.06)"/>
          <circle cx="95" cy="80" r="16" fill="rgba(255,255,255,0.04)"/>
        </svg>
      </div>
    </a>
    );
  })}
</div>

<style>
  .whats-new-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.625rem;
  }
  @media (max-width: 1280px) {
    .whats-new-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .whats-new-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .whats-new-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .whats-new-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.625rem;
    min-height: 110px;
    padding: 0.875rem 1rem;
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  /* Variant: vivid — saturated gradient fill, white ink (portal aesthetic) */
  .whats-new-grid--vivid .whats-new-grid__card { color: var(--color-white); }
  .whats-new-grid--vivid .whats-new-grid__title { color: var(--color-white); }
  .whats-new-grid--vivid .whats-new-grid__meta { color: rgba(255, 255, 255, 0.72); }
  .whats-new-grid--vivid .whats-new-grid__icon { color: rgba(255, 255, 255, 0.92); }
  .whats-new-grid--vivid .whats-new-grid__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
  }

  /* Variant: soft — tinted surfaces, dark accent ink (help aesthetic) */
  .whats-new-grid--soft .whats-new-grid__card {
    box-shadow: var(--sh-sm);
  }
  .whats-new-grid--soft .whats-new-grid__title {
    color: inherit;
  }
  .whats-new-grid--soft .whats-new-grid__meta {
    color: inherit;
    opacity: 0.7;
  }
  .whats-new-grid--soft .whats-new-grid__icon {
    color: inherit;
    opacity: 0.85;
  }
  .whats-new-grid--soft .whats-new-grid__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-md);
  }
  .whats-new-grid--soft .whats-new-grid__decoration svg {
    display: none;   /* no decorative circles on soft cards */
  }

  /* Variant: plain — white card with colored border + icon (cleanest) */
  .whats-new-grid--plain .whats-new-grid__card {
    background: var(--color-white);
    color: var(--color-ink);
    border-color: var(--color-cloud-grey);
  }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="green"]  .whats-new-grid__icon { color: var(--color-green); }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="blue"]   .whats-new-grid__icon { color: var(--color-slate-blue); }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="amber"]  .whats-new-grid__icon { color: var(--color-amber); }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="purple"] .whats-new-grid__icon { color: #6B47B5; }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="coral"]  .whats-new-grid__icon { color: var(--color-coral); }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="teal"]   .whats-new-grid__icon { color: var(--color-deep-teal); }
  .whats-new-grid--plain .whats-new-grid__card[data-accent="slate"]  .whats-new-grid__icon { color: var(--color-slate); }
  .whats-new-grid--plain .whats-new-grid__card:hover {
    transform: translateY(-2px);
    border-color: var(--color-green-line);
    box-shadow: var(--sh-md);
  }
  .whats-new-grid--plain .whats-new-grid__title { color: var(--color-ink); }
  .whats-new-grid--plain .whats-new-grid__meta { color: var(--color-ink-muted); }
  .whats-new-grid--plain .whats-new-grid__decoration svg { display: none; }

  /* Shared positioning */
  .whats-new-grid__icon {
    position: relative;
    z-index: 2;
  }
  .whats-new-grid__text {
    position: relative;
    z-index: 2;
  }
  .whats-new-grid__title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }
  .whats-new-grid__meta {
    font-size: var(--type-meta);
    margin: 0;
  }
  .whats-new-grid__decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .whats-new-grid__decoration svg {
    width: 100%;
    height: 100%;
  }
</style>
