---
/**
 * ReleaseTimeline — Three variants for rendering releases.
 *
 *   variant="timeline"  (default) — big vertical timeline with cards
 *   variant="log"       — compact rapid-fire log (dense text list)
 *   variant="mini"      — for use inside a widget/sidebar
 *
 * Theme-aware via --surface-page-* + --surface-widget-* tokens.
 */
export interface ReleaseEntry {
  id: string;
  title: string;
  description?: string;
  date?: string;
  version?: string;
  repo?: string;
  badge?: { text: string; variant: string };
  /** Consumer-provided href. If absent, builds "/release-notes/${id}/". */
  href?: string;
}

interface Props {
  entries: ReleaseEntry[];
  variant?: 'timeline' | 'log' | 'mini';
  showFilter?: boolean;
  hrefPrefix?: string;
  emptyMessage?: string;
}

const {
  entries = [],
  variant = 'timeline',
  showFilter = true,
  hrefPrefix = '/release-notes/',
  emptyMessage = 'No releases yet.',
} = Astro.props;

const hasMultipleRepos = new Set(entries.map((e) => e.repo).filter(Boolean)).size > 1;

function fmt(entry: ReleaseEntry) {
  const dateStr = entry.date
    ? new Date(entry.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
    : '';
  const href = entry.href || `${hrefPrefix}${entry.id}/`;
  const repoLabel =
    entry.repo === 'servantium-website' ? 'Website' :
    entry.repo === 'servantium' || entry.repo === 'servantium-app' ? 'App' : '';
  return { ...entry, dateStr, href, repoLabel };
}

const formatted = entries.map(fmt);
---

{entries.length === 0 ? (
  <p class="release-timeline__empty">{emptyMessage}</p>
) : (
  <div class:list={['release-timeline', `release-timeline--${variant}`]}>

    {/* ── FILTER CHIPS ── */}
    {variant !== 'mini' && showFilter && hasMultipleRepos && (
      <div class="release-timeline__filters">
        <button class="release-timeline__chip is-active" data-filter="all" type="button">All</button>
        <button class="release-timeline__chip" data-filter="servantium-website" type="button">Website</button>
        <button class="release-timeline__chip" data-filter="servantium" type="button">App</button>
      </div>
    )}

    {/* ── TIMELINE VARIANT ── */}
    {variant === 'timeline' && (
      <div class="release-timeline__list">
        <div class="release-timeline__line" aria-hidden="true"></div>
        {formatted.map((e, i) => (
          <div class="release-timeline__entry" data-repo={e.repo || ''}>
            <div class="release-timeline__dot" data-first={i === 0 || undefined} aria-hidden="true"></div>
            <a href={e.href} class="release-timeline__card">
              <div class="release-timeline__card-meta">
                {e.version && <span class="release-timeline__version">{e.version}</span>}
                {e.badge && <span class={`release-timeline__badge release-timeline__badge--${e.badge.variant}`}>{e.badge.text}</span>}
                {e.dateStr && <time class="release-timeline__date">{e.dateStr}</time>}
                {e.repoLabel && <span class="release-timeline__repo">{e.repoLabel}</span>}
              </div>
              <h3 class="release-timeline__title">{e.title}</h3>
              {e.description && <p class="release-timeline__desc">{e.description}</p>}
              <span class="release-timeline__cta">Read more &rarr;</span>
            </a>
          </div>
        ))}
      </div>
    )}

    {/* ── LOG VARIANT ── */}
    {variant === 'log' && (
      <ol class="release-timeline__log" role="list">
        {formatted.map((e) => (
          <li class="release-timeline__log-entry" data-repo={e.repo || ''}>
            <div class="release-timeline__log-meta">
              {e.version && <span class="release-timeline__version">{e.version}</span>}
              {e.dateStr && <time class="release-timeline__date">{e.dateStr}</time>}
              {e.repoLabel && <span class="release-timeline__repo">{e.repoLabel}</span>}
            </div>
            <a href={e.href} class="release-timeline__log-link">
              <strong class="release-timeline__log-title">{e.title}</strong>
              {e.description && <p class="release-timeline__log-desc">{e.description}</p>}
            </a>
          </li>
        ))}
      </ol>
    )}

    {/* ── MINI VARIANT ── */}
    {variant === 'mini' && (
      <ol class="release-timeline__mini" role="list">
        {formatted.map((e) => (
          <li>
            <a href={e.href} class="release-timeline__mini-link">
              {e.version && <span class="release-timeline__version">{e.version}</span>}
              <strong class="release-timeline__mini-title">{e.title}</strong>
              {e.dateStr && <time class="release-timeline__mini-date">{e.dateStr}</time>}
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
)}

<style>
  /* Shared */
  .release-timeline__empty {
    font-size: 0.9375rem;
    color: var(--surface-page-ink-muted);
    margin: 0;
    font-style: italic;
  }

  .release-timeline__filters {
    display: flex;
    gap: 0.25rem;
    margin-bottom: var(--v-space-md);
    background: var(--color-mist-grey);
    border-radius: var(--r-md);
    padding: 0.25rem;
    width: fit-content;
  }
  .release-timeline__chip {
    font-family: var(--font-body);
    font-size: var(--type-meta);
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: var(--r-sm);
    border: none;
    background: transparent;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color 0.15s var(--ease-out), background 0.15s var(--ease-out);
  }
  .release-timeline__chip:hover {
    color: var(--color-ink);
  }
  .release-timeline__chip.is-active {
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: var(--sh-sm);
  }

  .release-timeline__version {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    background: var(--color-green-soft);
    color: var(--color-green);
    border-radius: var(--r-pill);
    font-size: var(--type-meta);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .release-timeline__date {
    font-size: var(--type-meta);
    color: var(--surface-page-ink-muted);
  }
  .release-timeline__repo {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--surface-page-ink-muted);
  }

  .release-timeline__badge {
    padding: 0.125rem 0.5rem;
    border-radius: var(--r-pill);
    font-size: var(--type-meta);
    font-weight: 500;
  }
  .release-timeline__badge--success { background: var(--color-green-soft); color: var(--color-green); }
  .release-timeline__badge--caution { background: var(--color-amber-soft); color: var(--color-amber); }
  .release-timeline__badge--danger  { background: var(--color-coral-soft); color: var(--color-coral); }
  .release-timeline__badge--note    { background: var(--color-slate-blue-soft); color: var(--color-slate-blue); }

  /* Timeline variant */
  .release-timeline--timeline .release-timeline__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .release-timeline__line {
    position: absolute;
    left: 0.625rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--color-pale-green);
  }
  .release-timeline__entry {
    position: relative;
    padding-left: 2.5rem;
  }
  .release-timeline__dot {
    position: absolute;
    left: 0.375rem;
    top: 0.375rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--color-pale-green);
    border: 2px solid var(--color-white);
  }
  .release-timeline__dot[data-first] {
    background: var(--color-green);
  }
  .release-timeline__card {
    display: block;
    padding: 1.25rem;
    border-radius: var(--r-md);
    color: inherit !important;
    text-decoration: none !important;
    transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .release-timeline__card:hover {
    background: var(--color-mist-grey);
    transform: translateY(-2px);
  }
  .release-timeline__card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .release-timeline__title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--surface-page-ink);
    margin: 0 0 0.25rem;
    transition: color 0.2s var(--ease-out);
  }
  .release-timeline__card:hover .release-timeline__title {
    color: var(--color-green);
  }
  .release-timeline__desc {
    font-size: 0.875rem;
    color: var(--surface-page-ink-muted);
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .release-timeline__cta {
    font-size: var(--type-meta);
    font-weight: 600;
    color: var(--color-green);
  }

  /* Log variant */
  .release-timeline--log .release-timeline__log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .release-timeline__log-entry {
    padding: 1rem 0;
    border-bottom: 1px solid var(--surface-page-border);
  }
  .release-timeline__log-entry:last-child { border-bottom: none; }
  .release-timeline__log-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.375rem;
    flex-wrap: wrap;
  }
  .release-timeline__log-link {
    display: block;
    color: inherit !important;
    text-decoration: none !important;
  }
  .release-timeline__log-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--surface-page-ink);
  }
  .release-timeline__log-link:hover .release-timeline__log-title {
    color: var(--color-green);
  }
  .release-timeline__log-desc {
    font-size: 0.875rem;
    color: var(--surface-page-ink-muted);
    margin: 0.25rem 0 0;
    line-height: 1.55;
  }

  /* Mini variant */
  .release-timeline--mini .release-timeline__mini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .release-timeline__mini-link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.125rem 0.5rem;
    padding: 0.5rem 0;
    color: inherit !important;
    text-decoration: none !important;
    border-bottom: 1px solid var(--surface-widget-border);
  }
  .release-timeline__mini .release-timeline__version {
    grid-row: 1 / 3;
    align-self: start;
  }
  .release-timeline__mini-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--surface-widget-ink);
  }
  .release-timeline__mini-date {
    font-size: var(--type-meta);
    color: var(--surface-widget-ink-muted);
  }
</style>

<script is:inline>
  (function () {
    function initFilter() {
      document.querySelectorAll('.release-timeline').forEach(function (root) {
        var chips = root.querySelectorAll('.release-timeline__chip');
        var entries = root.querySelectorAll('[data-repo]');
        if (!chips.length || !entries.length) return;
        if (root.dataset.filterInit) return;
        root.dataset.filterInit = '1';

        chips.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var f = btn.dataset.filter || 'all';
            chips.forEach(function (c) { c.classList.remove('is-active'); });
            btn.classList.add('is-active');
            entries.forEach(function (e) {
              var repo = e.dataset.repo || '';
              e.style.display = (f === 'all' || repo === f) ? '' : 'none';
            });
          });
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFilter);
    } else { initFilter(); }
    document.addEventListener('astro:page-load', initFilter);
  })();
</script>
