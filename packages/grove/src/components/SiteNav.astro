---
/**
 * SiteNav — the main site navigation bar.
 *
 * Layout + styling only, content-neutral. Consumer passes `links`, `ctas`,
 * and `logoSrc` (or a logo via the `logo` slot). No marketing copy or
 * URL hardcoding lives in this component.
 *
 * Mobile menu, mega-menu dropdown persistence, focus trap, scroll-hide,
 * caret rotation — all included.
 */
import ResourceIcon from './ResourceIcons.astro';

export interface DropdownItem {
  href: string;
  label: string;
  description?: string;
  icon?: string;
}
export interface DropdownGroup {
  heading: string;
  items: DropdownItem[];
}
export interface NavLink {
  href: string;
  label: string;
  id: string;
  dropdown?: DropdownGroup[];
  megaFooter?: { label: string; description: string; href: string };
}
export interface NavCta {
  kind: 'primary' | 'secondary';
  label: string;
  href?: string;
  calLink?: string;
  calNamespace?: string;
  calConfig?: string;
  rel?: string;
}

interface Props {
  links: NavLink[];
  ctas?: NavCta[];
  activePage?: string;
  logoSrc?: string;
  logoAlt?: string;
  logoHref?: string;
}

const {
  links = [],
  ctas = [],
  activePage,
  logoSrc,
  logoAlt = 'Home',
  logoHref = '/',
} = Astro.props;
---

<nav aria-label="Main navigation" data-pagefind-ignore>
  <div class="container">
    <a href={logoHref} class="logo">
      <slot name="logo">
        {logoSrc && <img src={logoSrc} alt={logoAlt} class="logo-image" width={180} height={40} />}
      </slot>
    </a>
    <ul class="nav-links">
      {links.map(link => (
        <li class={link.dropdown ? 'has-dropdown' : ''}>
          <a
            href={link.href}
            class={activePage === link.id ? 'active' : ''}
            aria-haspopup={link.dropdown ? 'true' : undefined}
            aria-expanded={link.dropdown ? 'false' : undefined}
          >
            {link.label}
            {link.dropdown && (
              <svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </a>
          {link.dropdown && (
            <div class="nav-mega" role="menu" aria-label={`${link.label} menu`}>
              <div class="nav-mega-grid">
                {link.dropdown.map(group => (
                  <div class="nav-mega-col">
                    <div class="nav-mega-heading">{group.heading}</div>
                    <ul class="nav-mega-list">
                      {group.items.map(item => (
                        <li>
                          <a href={item.href} class="nav-mega-item" role="menuitem">
                            <span class="nav-mega-icon" aria-hidden="true">
                              {item.icon && <ResourceIcon name={item.icon as any} size={20} />}
                            </span>
                            <span class="nav-mega-text">
                              <span class="nav-mega-label">{item.label}</span>
                              {item.description && <span class="nav-mega-desc">{item.description}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              {link.megaFooter && (
                <a href={link.megaFooter.href} class="nav-mega-footer" role="menuitem">
                  <svg class="nav-mega-footer-art" width="140" height="96" viewBox="0 0 140 96" fill="none" aria-hidden="true">
                    <defs>
                      <linearGradient id={`rhArtGrad-${link.id}`} x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.45"/>
                        <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05"/>
                      </linearGradient>
                    </defs>
                    <circle cx="108" cy="20" r="28" fill={`url(#rhArtGrad-${link.id})`}/>
                    <rect x="58" y="44" width="34" height="44" rx="4" fill="#ffffff" fill-opacity="0.18" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.5"/>
                    <rect x="96" y="30" width="34" height="58" rx="4" fill="#ffffff" fill-opacity="0.22" stroke="#ffffff" stroke-opacity="0.7" stroke-width="1.5"/>
                    <rect x="20" y="56" width="34" height="32" rx="4" fill="#ffffff" fill-opacity="0.14" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.5"/>
                    <path d="M28 66 h18 M28 74 h14" stroke="#ffffff" stroke-opacity="0.75" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M66 54 h18 M66 62 h14 M66 70 h16" stroke="#ffffff" stroke-opacity="0.85" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M104 42 h18 M104 50 h14 M104 58 h16 M104 66 h12" stroke="#ffffff" stroke-opacity="0.95" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <div class="nav-mega-footer-copy">
                    <div class="nav-mega-footer-label">{link.megaFooter.label}</div>
                    <div class="nav-mega-footer-desc">{link.megaFooter.description}</div>
                  </div>
                  <span class="nav-mega-footer-arrow" aria-hidden="true">
                    <ResourceIcon name="arrow-right" size={18} />
                  </span>
                </a>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
    {ctas.length > 0 && (
      <div class="nav-buttons">
        {ctas.map(cta => (
          cta.calLink ? (
            <button
              class={`btn btn-${cta.kind} btn-nav`}
              data-cal-link={cta.calLink}
              data-cal-namespace={cta.calNamespace}
              data-cal-config={cta.calConfig}
            >{cta.label}</button>
          ) : (
            <a
              href={cta.href}
              class={`btn btn-${cta.kind} btn-nav`}
              data-astro-prefetch="false"
              rel={cta.rel}
            >{cta.label}</a>
          )
        ))}
      </div>
    )}
    <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <button class="mobile-menu-close" aria-label="Close menu" id="mobile-menu-close-btn">
    <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  {links.map(link => (
    link.dropdown ? (
      <div class="mobile-dropdown">
        <button class="mobile-dropdown-toggle" type="button" aria-expanded="false">
          {link.label}
          <svg class="mobile-dropdown-caret" width="12" height="12" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="mobile-dropdown-items" hidden>
          {link.dropdown.map(group => (
            group.items.map(item => (
              <a href={item.href} class="mobile-dropdown-link">{item.label}</a>
            ))
          ))}
        </div>
      </div>
    ) : (
      <a href={link.href}>{link.label}</a>
    )
  ))}
  {ctas.map(cta => (
    cta.calLink ? (
      <button class={`btn btn-${cta.kind}`} data-cal-link={cta.calLink} data-cal-namespace={cta.calNamespace} data-cal-config={cta.calConfig}>{cta.label}</button>
    ) : (
      <a href={cta.href} class={`btn btn-${cta.kind}`} data-astro-prefetch="false" rel={cta.rel}>{cta.label}</a>
    )
  ))}
</div>

<style>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: var(--v-space-sm, 1rem) 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-cloud-grey);
    transition: transform 0.3s ease;
  }
  nav .container {
    display: flex; justify-content: space-between; align-items: center;
    max-width: var(--max-width); margin: 0 auto; padding: 0 var(--v-space-md);
  }
  .logo { text-decoration: none; display: flex; align-items: center; flex-shrink: 0; overflow: visible; }
  .logo-image { height: 40px; width: auto; min-width: 180px; object-fit: contain; }
  .nav-links { display: flex; gap: var(--v-space-lg); list-style: none; margin: 0; padding: 0; }
  .nav-links li { position: relative; }
  .nav-links a {
    color: var(--color-ink-light); text-decoration: none; font-size: 1rem; font-weight: 500;
    transition: color 0.2s; display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.5rem 0;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--color-green); }
  .nav-caret { transition: transform 0.25s ease; opacity: 0.7; }
  .has-dropdown:hover .nav-caret, .has-dropdown:focus-within .nav-caret { transform: rotate(180deg); opacity: 1; }

  .nav-mega {
    position: absolute; top: calc(100% + 10px); left: 50%;
    transform: translate(-50%, -6px);
    width: min(960px, 92vw);
    background: var(--color-white);
    border: 1px solid var(--color-cloud-grey);
    border-radius: var(--r-xl);
    box-shadow: 0 30px 80px rgba(13,13,13,0.14), 0 2px 8px rgba(13,13,13,0.04);
    padding: 1.5rem 1.5rem 0;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 200; overflow: hidden;
  }
  .nav-mega::before { content: ''; position: absolute; top: -10px; left: 0; right: 0; height: 10px; }
  .has-dropdown:hover > .nav-mega,
  .has-dropdown:focus-within > .nav-mega,
  .has-dropdown.is-open > .nav-mega {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .nav-mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding-bottom: 1.25rem; }
  .nav-mega-col { min-width: 0; }
  .nav-mega-heading {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--color-ink-muted);
    margin: 0 0 0.5rem 0.75rem;
  }
  .nav-mega-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.125rem; }
  .nav-mega-item {
    display: flex !important; align-items: flex-start; gap: 0.85rem;
    padding: 0.7rem 0.75rem !important; border-radius: var(--r-md);
    color: var(--color-ink) !important; transition: background 0.15s ease; text-decoration: none;
  }
  .nav-mega-item:hover { background: var(--color-soft-mint); color: var(--color-ink) !important; }
  .nav-mega-item:hover .nav-mega-icon {
    background: var(--color-white); color: var(--color-green); border-color: var(--color-green);
  }
  .nav-mega-icon {
    flex-shrink: 0; width: 38px; height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-mist-grey);
    border: 1px solid var(--color-cloud-grey);
    border-radius: var(--r-md);
    color: var(--color-ink);
    transition: all 0.15s ease;
  }
  .nav-mega-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; line-height: 1.35; }
  .nav-mega-label { font-size: 0.92rem; font-weight: 600; color: var(--color-ink); line-height: 1.2; }
  .nav-mega-desc { font-size: 0.78rem; color: var(--color-ink-muted); font-weight: 400; line-height: 1.35; }
  .nav-mega-footer {
    display: flex !important; align-items: center; justify-content: space-between; gap: 1rem;
    position: relative; margin: 0 -1.5rem; padding: 1.15rem 1.75rem !important;
    background: linear-gradient(115deg, var(--color-deep-forest) 0%, #015c38 50%, var(--color-green) 100%);
    border-top: 1px solid var(--color-cloud-grey);
    text-decoration: none; color: var(--color-white) !important;
    overflow: hidden; transition: filter 0.2s ease;
  }
  .nav-mega-footer::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 85% 50%, rgba(255,255,255,0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .nav-mega-footer:hover { filter: brightness(1.08); color: var(--color-white) !important; }
  .nav-mega-footer:hover .nav-mega-footer-arrow { transform: translateX(4px); }
  .nav-mega-footer-art { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); opacity: 0.85; pointer-events: none; }
  .nav-mega-footer-copy { position: relative; z-index: 1; flex: 1; min-width: 0; }
  .nav-mega-footer-label { font-size: 0.98rem; font-weight: 700; color: var(--color-white); line-height: 1.2; letter-spacing: 0.01em; }
  .nav-mega-footer-desc { font-size: 0.8rem; color: rgba(255,255,255,0.85); margin-top: 0.2rem; }
  .nav-mega-footer-arrow {
    position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; background: rgba(255,255,255,0.18); border-radius: var(--r-pill);
    color: var(--color-white); transition: transform 0.18s ease, background 0.18s ease;
  }
  .nav-mega-footer:hover .nav-mega-footer-arrow { background: rgba(255,255,255,0.3); }
  @media (max-width: 900px) {
    .nav-mega-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 600; border-radius: var(--r-sm); text-decoration: none;
    cursor: pointer; transition: all 0.25s ease; border: none; font-family: inherit;
  }
  .btn-primary {
    background: var(--color-green); color: var(--color-white);
    box-shadow: 0 2px 8px rgba(0,194,109,0.25);
  }
  .btn-primary:hover { background: var(--color-green-hover); transform: translateY(-1px); }
  .btn-secondary {
    background: transparent; color: var(--color-ink);
    border: 1.5px solid var(--color-cloud-grey);
  }
  .btn-secondary:hover { border-color: var(--color-green); color: var(--color-green); }
  .btn-nav { padding: 0.5rem 1rem; font-size: 0.85rem; }
  .nav-buttons { display: flex; gap: 0.75rem; align-items: center; }

  .mobile-menu-toggle {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 28px; height: 28px; background: none; border: none;
    cursor: pointer; padding: 0; z-index: 1001;
  }
  .mobile-menu-toggle span {
    display: block; width: 100%; height: 2px;
    background: var(--color-ink); border-radius: 2px; transition: all 0.3s ease;
  }
  .mobile-menu-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .mobile-menu-toggle.active span:nth-child(2) { opacity: 0; }
  .mobile-menu-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  .mobile-menu {
    display: none;
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: var(--color-white); z-index: 999;
    padding: var(--v-space-lg); padding-top: 80px;
    flex-direction: column; gap: var(--v-space-sm);
    overflow-y: auto; -webkit-overflow-scrolling: touch;
  }
  .mobile-menu.active { display: flex; }
  .mobile-menu-close {
    position: absolute; top: calc(env(safe-area-inset-top, 0px) + var(--v-space-sm));
    right: var(--v-space-lg); width: 44px; height: 44px;
    background: none; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; padding: 0; z-index: 1002;
  }
  .mobile-menu-close svg { width: 28px; height: 28px; stroke: var(--color-ink); stroke-width: 2; }
  .mobile-menu-close:hover svg { stroke: var(--color-green); }
  .mobile-menu a:not(.btn) {
    display: block; padding: var(--v-space-md) 0;
    font-size: 1.25rem; font-weight: 500; color: var(--color-ink);
    text-decoration: none; border-bottom: 1px solid var(--color-cloud-grey);
    transition: color 0.2s;
  }
  .mobile-menu a:not(.btn):hover { color: var(--color-green); }
  .mobile-menu .btn { margin-top: var(--v-space-md); justify-content: center; padding: 1rem 2rem; font-size: 1rem; }

  .mobile-dropdown { border-bottom: 1px solid var(--color-cloud-grey); }
  .mobile-dropdown-toggle {
    display: flex; align-items: center; justify-content: space-between; width: 100%;
    padding: var(--v-space-md) 0; font-size: 1.25rem; font-weight: 500;
    color: var(--color-ink); background: none; border: none; cursor: pointer;
    font-family: inherit; text-align: left; transition: color 0.2s;
  }
  .mobile-dropdown-toggle:hover { color: var(--color-green); }
  .mobile-dropdown-caret { transition: transform 0.25s ease; opacity: 0.5; flex-shrink: 0; }
  .mobile-dropdown-toggle[aria-expanded="true"] .mobile-dropdown-caret { transform: rotate(180deg); opacity: 1; }
  .mobile-dropdown-items { padding: 0 0 0.5rem 1rem; }
  .mobile-dropdown-items[hidden] { display: none; }
  .mobile-dropdown-link {
    display: block; padding: 0.65rem 0; font-size: 1.05rem; font-weight: 500;
    color: var(--color-ink-light); text-decoration: none; transition: color 0.2s;
  }
  .mobile-dropdown-link:hover { color: var(--color-green); }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-buttons { display: none; }
    .mobile-menu-toggle { display: flex; }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
      var mobileMenu = document.getElementById('mobile-menu');
      var mobileMenuCloseBtn = document.getElementById('mobile-menu-close-btn');
      if (!mobileMenuToggle || mobileMenuToggle.dataset.wired) return;
      mobileMenuToggle.dataset.wired = '1';

      var removeFocusTrap = null;
      function closeMobileMenu() {
        if (removeFocusTrap) { removeFocusTrap(); removeFocusTrap = null; }
        mobileMenu && mobileMenu.classList.remove('active');
        mobileMenu && mobileMenu.setAttribute('aria-hidden', 'true');
        mobileMenuToggle.classList.remove('active');
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        mobileMenuToggle.focus();
      }
      mobileMenuToggle.addEventListener('click', function () {
        var isActive = mobileMenu && mobileMenu.classList.toggle('active');
        this.classList.toggle('active');
        this.setAttribute('aria-expanded', String(isActive));
        mobileMenu && mobileMenu.setAttribute('aria-hidden', String(!isActive));
        document.body.style.overflow = isActive ? 'hidden' : '';
        if (isActive && mobileMenu) {
          var focusable = mobileMenu.querySelectorAll(
            'a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])'
          );
          var first = focusable[0], last = focusable[focusable.length - 1];
          function trapHandler(e) {
            if (e.key !== 'Tab') return;
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last && last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first && first.focus(); }
          }
          mobileMenu.addEventListener('keydown', trapHandler);
          removeFocusTrap = function () { mobileMenu.removeEventListener('keydown', trapHandler); };
          first && first.focus();
        }
      });
      mobileMenuCloseBtn && mobileMenuCloseBtn.addEventListener('click', closeMobileMenu);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && mobileMenu && mobileMenu.classList.contains('active')) closeMobileMenu();
      });

      // Mobile dropdown toggles
      document.querySelectorAll('.mobile-dropdown-toggle').forEach(function (btn) {
        if (btn.dataset.wired) return;
        btn.dataset.wired = '1';
        btn.addEventListener('click', function () {
          var items = btn.nextElementSibling;
          var expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          if (expanded) items.setAttribute('hidden', '');
          else items.removeAttribute('hidden');
        });
      });

      // Mega-menu persistence (hover + click + focus)
      var OPEN_DELAY = 80, CLOSE_DELAY = 220;
      document.querySelectorAll('.has-dropdown').forEach(function (li) {
        if (li.dataset.wired) return;
        li.dataset.wired = '1';
        var openT = null, closeT = null;
        function clearTimers() { if (openT) clearTimeout(openT); if (closeT) clearTimeout(closeT); openT = closeT = null; }
        function open() {
          clearTimers();
          document.querySelectorAll('.has-dropdown').forEach(function (o) { if (o !== li) o.classList.remove('is-open'); });
          openT = setTimeout(function () { li.classList.add('is-open'); }, OPEN_DELAY);
        }
        function close() {
          clearTimers();
          closeT = setTimeout(function () { li.classList.remove('is-open'); }, CLOSE_DELAY);
        }
        li.addEventListener('mouseenter', open);
        li.addEventListener('mouseleave', close);
        li.addEventListener('focusin', open);
        li.addEventListener('focusout', function (e) { if (!li.contains(e.relatedTarget)) close(); });
        var trigger = li.querySelector(':scope > a');
        if (trigger) {
          trigger.addEventListener('click', function (e) {
            if (window.innerWidth <= 768) return;
            if (li.classList.contains('is-open')) return;
            e.preventDefault();
            open();
            clearTimeout(openT);
            li.classList.add('is-open');
          });
        }
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.has-dropdown')) {
          document.querySelectorAll('.has-dropdown').forEach(function (li) { li.classList.remove('is-open'); });
        }
      });

      // Scroll-hide on mobile/tablet
      var lastScroll = 0, navHovered = false;
      var nav = document.querySelector('nav');
      if (nav) {
        nav.addEventListener('mouseenter', function () { navHovered = true; });
        nav.addEventListener('mouseleave', function () { navHovered = false; });
        nav.addEventListener('focusin', function () { navHovered = true; });
        nav.addEventListener('focusout', function () { navHovered = false; });
      }
      window.addEventListener('scroll', function () {
        if (window.innerWidth > 1024) return;
        if (navHovered) return;
        if (!nav) return;
        var current = window.scrollY;
        if (current > lastScroll && current > 100) nav.style.transform = 'translateY(-100%)';
        else nav.style.transform = 'translateY(0)';
        lastScroll = current;
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
