---
/**
 * SearchBanner
 *
 * Hero banner with centered title + search input + example pills.
 * Theme-aware: colors come from --surface-banner-* tokens, so it
 * adapts to light, dark, accent, or any custom theme without
 * per-component dark mode code.
 *
 * The ⌘K / Ctrl+K keyboard hint adapts to the user's platform at
 * runtime (checks navigator.platform on page load).
 */
export interface Example {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  searchPlaceholder?: string;
  examples?: Example[];
  /** When true, renders with more vertical padding for hero use. */
  variant?: 'compact' | 'hero';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  searchPlaceholder = 'Search docs…',
  examples = [],
  variant = 'hero',
  class: className = '',
} = Astro.props;
---

<section class:list={['search-banner', `search-banner--${variant}`, className]} aria-label="Search">
  <div class="search-banner__inner">
    {eyebrow && (
      <div class="search-banner__eyebrow">
        <span class="search-banner__eyebrow-dash" aria-hidden="true"></span>
        {eyebrow}
      </div>
    )}
    <h1 class="search-banner__title" set:html={title} />
    {subtitle && <p class="search-banner__subtitle">{subtitle}</p>}

    <div class="search-banner__search">
      <svg class="search-banner__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        class="search-banner__input"
        placeholder={searchPlaceholder}
        aria-label={searchPlaceholder}
        data-search-banner-input
        aria-keyshortcuts="Meta+K Control+K"
      />
      <kbd class="search-banner__kbd" data-platform-shortcut>⌘K</kbd>
    </div>

    {examples.length > 0 && (
      <ul class="search-banner__examples" role="list">
        {examples.map((ex) => (
          <li>
            {ex.href ? (
              <a href={ex.href} class="search-banner__example">{ex.label}</a>
            ) : (
              <button class="search-banner__example" type="button" data-example-query={ex.label}>{ex.label}</button>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .search-banner {
    background: var(--surface-banner);
    color: var(--surface-banner-ink);
    border-radius: var(--r-2xl);
    padding: var(--v-space-xl) var(--v-space-md);
    position: relative;
    overflow: hidden;
  }

  .search-banner--hero {
    padding: var(--v-space-2xl) var(--v-space-md);
  }

  .search-banner__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: left;
  }

  .search-banner__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--v-space-xs);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--surface-banner-muted);
    margin-bottom: var(--v-space-sm);
  }

  .search-banner__eyebrow-dash {
    width: 24px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  .search-banner__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 var(--v-space-sm);
    color: var(--surface-banner-ink);
  }
  .search-banner__title :global(em) {
    font-style: italic;
    color: var(--color-fresh-green);
  }

  .search-banner__subtitle {
    color: var(--surface-banner-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
    margin: 0 0 var(--v-space-md);
    max-width: 620px;
  }

  .search-banner__search {
    display: flex;
    align-items: center;
    gap: var(--v-space-xs);
    padding: 0.75rem 1rem;
    background: var(--surface-banner-input);
    border: 1px solid var(--surface-banner-border);
    border-radius: var(--r-md);
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .search-banner__search:focus-within {
    border-color: var(--color-fresh-green);
    box-shadow: 0 0 0 3px var(--color-green-soft);
  }

  .search-banner__search-icon {
    color: var(--surface-banner-muted);
    flex-shrink: 0;
  }

  .search-banner__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--surface-banner-input-ink);
    font-family: var(--font-body);
    font-size: var(--type-base);
  }
  .search-banner__input::placeholder {
    color: var(--surface-banner-input-placeholder);
  }

  .search-banner__kbd {
    padding: 0.25rem 0.5rem;
    background: var(--surface-banner-chip);
    color: var(--surface-banner-chip-ink);
    border-radius: var(--r-sm);
    font-family: var(--font-body);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .search-banner__examples {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v-space-xs);
    margin: var(--v-space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .search-banner__example {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    background: var(--surface-banner-chip);
    color: var(--surface-banner-chip-ink);
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.18s var(--ease-out), border-color 0.18s var(--ease-out);
  }
  .search-banner__example:hover {
    border-color: var(--color-green-line);
    background: var(--color-green-soft);
  }
</style>

<script is:inline>
  (function () {
    function applyShortcut() {
      var isMac = /Mac|iP(hone|od|ad)/.test(navigator.platform);
      document.querySelectorAll('[data-platform-shortcut]').forEach(function (el) {
        el.textContent = isMac ? '\u2318K' : 'Ctrl+K';
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyShortcut);
    } else {
      applyShortcut();
    }
    document.addEventListener('astro:page-load', applyShortcut);
  })();
</script>
