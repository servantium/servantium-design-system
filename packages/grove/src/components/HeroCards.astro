---
/**
 * HeroCards — 3-up colorful gradient card row for help landings.
 * Each card has a gradient background, decorative SVG, and a CTA.
 *
 * Port of the Read-docs / Explore-AI / Watch-screencasts pattern
 * from the original help home, theme-aware via surface tokens.
 */
export interface HeroCard {
  title: string;
  description: string;
  ctaLabel?: string;
  href?: string;
  accent?: 'green' | 'blue' | 'amber' | 'purple' | 'coral' | 'teal';
  decoration?: 'docs' | 'ai' | 'video' | 'custom';
  comingSoon?: boolean;
}

interface Props {
  cards: HeroCard[];
  class?: string;
}
const { cards = [], class: className = '' } = Astro.props;

const gradients: Record<string, string> = {
  green:  'linear-gradient(135deg, #036E3E 0%, #023E25 100%)',
  blue:   'linear-gradient(135deg, #3E6E9A 0%, #1E3850 100%)',
  amber:  'linear-gradient(135deg, #D88B2A 0%, #8C521B 100%)',
  purple: 'linear-gradient(135deg, #6B47B5 0%, #3B2570 100%)',
  coral:  'linear-gradient(135deg, #D95266 0%, #8B2D3D 100%)',
  teal:   'linear-gradient(135deg, #1A8A7F 0%, #0E4F49 100%)',
};
---

<div class:list={['hero-cards', className]}>
  {cards.map((card) => {
    const grad = gradients[card.accent || 'green'];
    const Root: any = card.href ? 'a' : 'div';
    return (
      <Root href={card.href} class="hero-cards__card" style={`background: ${grad};`}>
        <div class="hero-cards__content">
          <h3 class="hero-cards__title">{card.title}</h3>
          <p class="hero-cards__desc">{card.description}</p>
          {card.comingSoon ? (
            <span class="hero-cards__coming">Coming soon</span>
          ) : card.ctaLabel && (
            <span class="hero-cards__cta">{card.ctaLabel} &rarr;</span>
          )}
        </div>
        <div class="hero-cards__decoration" aria-hidden="true">
          {card.decoration === 'docs' && (
            <svg viewBox="0 0 180 140" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.25">
              <rect x="20" y="20" width="56" height="100" rx="3"/>
              <line x1="30" y1="40" x2="66" y2="40"/>
              <line x1="30" y1="52" x2="60" y2="52"/>
              <line x1="30" y1="64" x2="66" y2="64"/>
              <line x1="30" y1="76" x2="54" y2="76"/>
              <rect x="90" y="20" width="56" height="100" rx="3"/>
              <line x1="100" y1="40" x2="136" y2="40"/>
              <line x1="100" y1="52" x2="130" y2="52"/>
              <line x1="100" y1="64" x2="136" y2="64"/>
              <line x1="100" y1="76" x2="124" y2="76"/>
              <line x1="100" y1="88" x2="134" y2="88"/>
            </svg>
          )}
          {card.decoration === 'ai' && (
            <svg viewBox="0 0 180 140" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.28">
              <circle cx="90" cy="70" r="8"/>
              <circle cx="50" cy="40" r="5"/>
              <circle cx="130" cy="40" r="5"/>
              <circle cx="40" cy="90" r="5"/>
              <circle cx="140" cy="90" r="5"/>
              <circle cx="90" cy="20" r="5"/>
              <circle cx="90" cy="120" r="5"/>
              <line x1="90" y1="70" x2="50" y2="40"/>
              <line x1="90" y1="70" x2="130" y2="40"/>
              <line x1="90" y1="70" x2="40" y2="90"/>
              <line x1="90" y1="70" x2="140" y2="90"/>
              <line x1="90" y1="70" x2="90" y2="20"/>
              <line x1="90" y1="70" x2="90" y2="120"/>
            </svg>
          )}
          {card.decoration === 'video' && (
            <svg viewBox="0 0 180 140" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.28">
              <rect x="30" y="30" width="120" height="80" rx="6"/>
              <polygon points="80,55 110,70 80,85" fill="currentColor" stroke="none"/>
              <line x1="30" y1="100" x2="150" y2="100"/>
              <circle cx="45" cy="105" r="3" fill="currentColor" stroke="none"/>
              <circle cx="60" cy="105" r="3" fill="none"/>
              <circle cx="75" cy="105" r="3" fill="none"/>
            </svg>
          )}
          {card.decoration === 'custom' && <slot name={`decoration-${card.title}`} />}
        </div>
      </Root>
    );
  })}
</div>

<style>
  .hero-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin: 0 0 var(--v-space-lg);
  }

  .hero-cards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 340px;
    padding: 1.5rem;
    border-radius: var(--r-xl);
    color: var(--color-white);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
  }
  .hero-cards__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.18);
  }

  .hero-cards__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .hero-cards__title {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-white);
    margin: 0;
    line-height: 1.2;
  }

  .hero-cards__desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 26ch;
  }

  .hero-cards__cta,
  .hero-cards__coming {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-white);
  }
  .hero-cards__coming {
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
    font-weight: 500;
  }

  .hero-cards__decoration {
    position: absolute;
    right: -10px;
    bottom: -10px;
    width: 180px;
    height: 140px;
    color: var(--color-white);
    pointer-events: none;
  }
  .hero-cards__decoration svg {
    width: 100%;
    height: 100%;
  }
</style>
