---
/**
 * SiteFooter — main site footer.
 *
 * Layout + styling only. Consumer passes `columns`, `brand`, `contactEmail`,
 * and optional `social` + `founders`. No hardcoded content.
 */
export interface FooterLink {
  href: string;
  label: string;
}
export interface FooterColumn {
  heading: string;
  items: FooterLink[];
}
export interface FooterSocial {
  linkedin?: string;
  twitter?: string;
  github?: string;
}
export interface FooterFounder {
  name: string;
  href?: string;
}

interface Props {
  columns: FooterColumn[];
  brand: {
    name: string;
    tagline?: string;
    logoSrc?: string;
    logoAlt?: string;
    logoHref?: string;
  };
  contactEmail?: string;
  social?: FooterSocial;
  founders?: FooterFounder[];
  currentYear?: number;
}

const {
  columns = [],
  brand,
  contactEmail,
  social,
  founders = [],
  currentYear = new Date().getFullYear(),
} = Astro.props;
---

<footer role="contentinfo" data-pagefind-ignore>
  <div class="container">
    <div class="footer-grid" style={`grid-template-columns: 1.5fr repeat(${columns.length}, 1fr);`}>
      <div class="footer-brand">
        <a href={brand.logoHref || '/'} class="logo">
          {brand.logoSrc && <img src={brand.logoSrc} alt={brand.logoAlt || brand.name} class="logo-image footer-logo" width={180} height={40} />}
        </a>
        {brand.tagline && <p>{brand.tagline}</p>}
        {social && (social.linkedin || social.twitter || social.github) && (
          <div class="footer-social">
            <span class="footer-social-label">Follow us on</span>
            {social.linkedin && (
              <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={`${brand.name} on LinkedIn`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
      {columns.map(col => (
        <div class="footer-column">
          <div role="heading" aria-level="3" class="footer-heading">{col.heading}</div>
          <ul>
            {col.items.map(item => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span>&copy; {currentYear} {brand.name} Inc.</span>
        {contactEmail && (
          <>
            <span class="footer-divider">&middot;</span>
            <button class="footer-email-chip" id="footer-email-chip" aria-label={`Copy email address ${contactEmail} to clipboard`} data-email={contactEmail}>
              <span class="footer-email-chip-text">{contactEmail}</span>
              <svg class="footer-email-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
          </>
        )}
      </div>
      {founders.length > 0 && (
        <div class="footer-bottom-right">
          <span>
            Founded by {founders.map((f, i) => (
              <>
                {f.href ? <a href={f.href}>{f.name}</a> : <span>{f.name}</span>}
                {i < founders.length - 1 && ' & '}
              </>
            ))}
          </span>
        </div>
      )}
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--color-ink);
    color: var(--color-white);
    padding: var(--v-space-xl) 0 var(--v-space-md);
  }
  footer .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--v-space-lg);
  }
  .footer-grid {
    display: grid;
    gap: var(--v-space-lg);
    margin-bottom: var(--v-space-lg);
  }
  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1.5fr 1fr 1fr !important; }
  }
  .footer-brand { max-width: 280px; }
  .footer-brand .logo { margin-bottom: var(--v-space-sm); }
  .footer-brand p { font-size: 0.9rem; opacity: 0.6; color: var(--color-white); line-height: 1.6; margin-bottom: var(--v-space-sm); }
  .footer-logo { filter: brightness(0) invert(1); height: 40px; width: auto; min-width: 180px; object-fit: contain; }
  .footer-social { display: flex; align-items: center; gap: 0.5rem; margin-top: var(--v-space-sm); }
  .footer-social-label { font-size: 0.85rem; opacity: 0.7; }
  .social-link {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: var(--r-sm);
    background: rgba(255,255,255,0.1); color: var(--color-white);
    transition: all 0.2s ease; text-decoration: none;
  }
  .social-link:hover { background: var(--color-green); transform: translateY(-1px); }
  .footer-column .footer-heading {
    font-family: var(--font-body); font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
    margin-bottom: var(--v-space-sm); opacity: 0.6; color: var(--color-white);
  }
  .footer-column ul { list-style: none; padding: 0; margin: 0; }
  .footer-column li { margin-bottom: 0.35rem; }
  .footer-column a { color: var(--color-white); opacity: 0.7; text-decoration: none; font-size: 0.9rem; transition: opacity 0.2s; }
  .footer-column a:hover { opacity: 1; }
  .footer-bottom {
    padding-top: var(--v-space-md); border-top: 1px solid rgba(255,255,255,0.1);
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.85rem; opacity: 0.7;
  }
  .footer-bottom-left { display: flex; align-items: center; gap: 0.5rem; }
  .footer-divider { opacity: 0.5; }
  .footer-bottom a { color: var(--color-white); text-decoration: none; transition: opacity 0.2s; }
  .footer-bottom a:hover { opacity: 1; text-decoration: underline; }
  .footer-email-chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; background: transparent;
    border: 1.5px solid var(--color-green);
    border-radius: var(--r-pill); cursor: pointer;
    transition: all 0.2s ease; font-family: inherit; font-size: 0.85rem;
  }
  .footer-email-chip:hover { background: rgba(0,194,109,0.15); }
  .footer-email-chip-text { color: var(--color-green); font-weight: 500; }
  .footer-email-chip-icon { width: 14px; height: 14px; color: var(--color-green); flex-shrink: 0; }
  .footer-email-chip.copied { background: var(--color-green); border-color: var(--color-green); }
  .footer-email-chip.copied .footer-email-chip-text,
  .footer-email-chip.copied .footer-email-chip-icon { color: var(--color-white); }

  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr 1fr !important; gap: var(--v-space-lg); }
    .footer-bottom { flex-direction: column; gap: var(--v-space-sm); text-align: center; }
    .footer-bottom-left { flex-direction: column; gap: 0.25rem; }
    .footer-divider { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var chip = document.getElementById('footer-email-chip');
    if (!chip || chip.dataset.wired) return;
    chip.dataset.wired = '1';
    chip.addEventListener('click', function () {
      var email = chip.dataset.email;
      if (!email) return;
      var text = chip.querySelector('.footer-email-chip-text');
      var icon = chip.querySelector('.footer-email-chip-icon');
      navigator.clipboard.writeText(email).then(function () {
        chip.classList.add('copied');
        if (text) text.textContent = 'Copied!';
        if (icon) icon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
        setTimeout(function () {
          chip.classList.remove('copied');
          if (text) text.textContent = email;
          if (icon) icon.innerHTML = '<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>';
        }, 2000);
      }).catch(function () {
        window.location.href = 'mailto:' + email;
      });
    });
  })();
</script>
