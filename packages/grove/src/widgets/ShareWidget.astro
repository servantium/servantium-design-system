---
/**
 * ShareWidget — social share icons + copy-link button.
 * Auto-builds share URLs from the current page's canonical URL.
 */
import Widget from './Widget.astro';

interface Props {
  title?: string;
  networks?: Array<'linkedin' | 'twitter' | 'email' | 'copy'>;
  url?: string;   // optional override; defaults to window.location client-side
}

const {
  title = 'Share',
  networks = ['linkedin', 'twitter', 'email', 'copy'],
  url,
} = Astro.props;
---

<Widget title={title} variant="default" compact>
  <div class="share-widget__row" data-share-url={url || ''}>
    {networks.includes('linkedin') && (
      <button type="button" class="share-widget__btn" data-share="linkedin" aria-label="Share on LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zm-10.75 6H5.5v9h2.75V9zm-1.375-3.75a1.625 1.625 0 1 0 0 3.25 1.625 1.625 0 0 0 0-3.25zM19 18v-4.92c0-2.64-1.43-3.87-3.33-3.87a2.86 2.86 0 0 0-2.6 1.43V9h-2.75v9h2.75v-4.75c0-1.28.5-2.15 1.78-2.15 1.25 0 1.65.88 1.65 2.15V18H19z"/></svg>
      </button>
    )}
    {networks.includes('twitter') && (
      <button type="button" class="share-widget__btn" data-share="twitter" aria-label="Share on X / Twitter">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
      </button>
    )}
    {networks.includes('email') && (
      <button type="button" class="share-widget__btn" data-share="email" aria-label="Share via email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      </button>
    )}
    {networks.includes('copy') && (
      <button type="button" class="share-widget__btn" data-share="copy" aria-label="Copy link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
    )}
  </div>
  <p class="share-widget__status" data-share-status aria-live="polite"></p>
</Widget>

<style>
  .share-widget__row {
    display: flex;
    gap: 0.5rem;
  }
  .share-widget__btn {
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: transparent;
    border: 1px solid var(--surface-widget-border);
    color: var(--surface-widget-ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s var(--ease-out), border-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }
  .share-widget__btn:hover {
    background: var(--color-green-soft);
    border-color: var(--color-green-line);
    color: var(--surface-widget-accent);
  }
  .share-widget__status {
    font-size: var(--type-meta);
    color: var(--surface-widget-ink-muted);
    min-height: 1.1em;
    margin: 0.5rem 0 0;
  }
</style>

<script is:inline>
  (function () {
    function initShare() {
      document.querySelectorAll('[data-share]').forEach(function (btn) {
        if (btn.dataset.shareInit) return;
        btn.dataset.shareInit = '1';
        btn.addEventListener('click', function () {
          var row = btn.closest('[data-share-url]');
          var url = (row && row.dataset.shareUrl) || window.location.href;
          var status = btn.closest('.widget').querySelector('[data-share-status]');
          var net = btn.dataset.share;
          if (net === 'linkedin') {
            window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url), '_blank', 'noopener');
          } else if (net === 'twitter') {
            window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(url), '_blank', 'noopener');
          } else if (net === 'email') {
            window.location.href = 'mailto:?body=' + encodeURIComponent(url);
          } else if (net === 'copy') {
            if (navigator.clipboard) {
              navigator.clipboard.writeText(url).then(function () {
                if (status) { status.textContent = 'Link copied.'; setTimeout(function () { status.textContent = ''; }, 2400); }
              });
            }
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShare);
    } else { initShare(); }
    document.addEventListener('astro:page-load', initShare);
  })();
</script>
