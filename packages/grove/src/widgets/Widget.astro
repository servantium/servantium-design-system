---
/**
 * Widget — base primitive for sidebar/rail cards.
 *
 * All styled widgets (StillStuck, Changelog, Contact, Related, etc.)
 * compose this. Consumers can also build custom widgets by wrapping
 * their own content in <Widget>.
 *
 * Theming: derives colors from --surface-widget-* tokens. Override
 * locally by wrapping in <ThemeProvider theme="accent"> or by setting
 * data-theme on a parent.
 */
interface Props {
  title?: string;
  icon?: string;
  eyebrow?: string;
  href?: string;                  // makes the whole widget clickable
  variant?: 'default' | 'accent'; // "accent" uses themed accent surface
  compact?: boolean;
  class?: string;
}

const {
  title,
  icon,
  eyebrow,
  href,
  variant = 'default',
  compact = false,
  class: className = '',
} = Astro.props;

const Root = href ? 'a' : 'section';
---

<Root
  href={href}
  class:list={[
    'widget',
    `widget--${variant}`,
    compact && 'widget--compact',
    href && 'widget--clickable',
    className,
  ]}
  data-theme={variant === 'accent' ? 'accent' : undefined}
>
  {(eyebrow || title || icon) && (
    <header class="widget__header">
      {icon && (
        <span class="widget__icon" aria-hidden="true">
          <Fragment set:html={icon} />
        </span>
      )}
      <div class="widget__titles">
        {eyebrow && <div class="widget__eyebrow">{eyebrow}</div>}
        {title && <h3 class="widget__title">{title}</h3>}
      </div>
    </header>
  )}
  <div class="widget__body">
    <slot />
  </div>
</Root>

<style>
  .widget {
    display: block;
    background: var(--surface-widget);
    color: var(--surface-widget-ink);
    border: 1px solid var(--surface-widget-border);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    box-shadow: var(--surface-widget-shadow);
    text-decoration: none;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .widget--compact {
    padding: 1rem;
    border-radius: var(--r-md);
  }
  .widget--clickable:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-lg);
  }

  .widget__header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .widget__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: var(--color-green-soft);
    color: var(--surface-widget-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .widget--compact .widget__icon {
    width: 28px;
    height: 28px;
  }
  .widget__titles {
    flex: 1;
    min-width: 0;
  }
  .widget__eyebrow {
    font-size: var(--type-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--surface-widget-ink-muted);
    margin-bottom: 0.25rem;
  }
  .widget__title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--surface-widget-ink);
    margin: 0;
  }
  .widget__body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--surface-widget-ink-muted);
  }
  .widget__body :global(> *:last-child) {
    margin-bottom: 0;
  }
  .widget__body :global(a) {
    color: var(--surface-widget-accent);
    text-decoration: none;
  }
  .widget__body :global(a:hover) {
    text-decoration: underline;
  }
</style>
