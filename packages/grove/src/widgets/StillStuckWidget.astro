---
/**
 * StillStuckWidget — "Need more help?" support card.
 *
 * Uses `variant="accent"` by default (themed accent surface), so it
 * pops out of the sidebar. Override by passing variant="default".
 */
import Widget from './Widget.astro';

interface Props {
  title?: string;
  description?: string;
  variant?: 'default' | 'accent';
  emailHref?: string;
  slackHref?: string;
  bookingHref?: string;
}

const {
  title = 'Still stuck?',
  description = 'The team reads every message. No bots on the front line, no auto-replies.',
  variant = 'accent',
  emailHref = 'mailto:help@servantium.com',
  slackHref,
  bookingHref,
} = Astro.props;
---

<Widget title={title} variant={variant}>
  <p class="still-stuck__desc">{description}</p>

  <ul class="still-stuck__list" role="list">
    {emailHref && (
      <li>
        <a href={emailHref} class="still-stuck__link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="M3 7l9 6 9-6"/>
          </svg>
          <span>
            <strong>Email the team</strong>
            <small>help@servantium.com</small>
          </span>
        </a>
      </li>
    )}
    {slackHref && (
      <li>
        <a href={slackHref} class="still-stuck__link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 14v4a2 2 0 0 1-4 0V4"/>
            <path d="M16 10h4a2 2 0 0 0 0-4H4"/>
            <path d="M14 16h4a2 2 0 0 1 0 4"/>
            <path d="M10 8V4a2 2 0 0 0-4 0v4"/>
          </svg>
          <span>
            <strong>Ask in Slack</strong>
            <small>Community channel</small>
          </span>
        </a>
      </li>
    )}
    {bookingHref && (
      <li>
        <a href={bookingHref} class="still-stuck__link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span>
            <strong>Book a 1:1</strong>
            <small>30-min onboarding call</small>
          </span>
        </a>
      </li>
    )}
  </ul>
</Widget>

<style>
  .still-stuck__desc {
    font-size: 0.875rem;
    margin: 0 0 1rem;
  }
  .still-stuck__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .still-stuck__link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--r-sm);
    background: transparent;
    color: inherit !important;
    text-decoration: none !important;
    transition: background 0.15s var(--ease-out);
  }
  .still-stuck__link:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .still-stuck__link span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .still-stuck__link strong {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .still-stuck__link small {
    font-size: 0.75rem;
    opacity: 0.7;
  }
</style>
